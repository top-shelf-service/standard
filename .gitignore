# Top Shelf Service LLC - .gitignore
# Proprietary and Confidential

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary files
*.tmp
*.log
*.bak
.~*

# Build artifacts (if any tools generate them)
dist/
build/
out/
*.min.css
*.min.js

# Dependencies (if tooling is added later)
node_modules/
vendor/

# Environment files
.env
.env.local
.env.*.local

# Test coverage
coverage/
.nyc_output/

# Documentation builds
docs/build/
site/
