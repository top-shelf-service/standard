# Top Shelf Service LLC - .gitignore
# Proprietary and Confidential

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary files
*.tmp
*.log
*.bak
.~*

# Build artifacts (if any tools generate them)
dist/
build/
out/
*.min.css
*.min.js

# Dependencies
node_modules/
vendor/

# Environment files
.env
.env.local
.env.*.local
.env.active
.env.dev
.env.stage
.env.prod

# Agent runtime state
.agent-env-watch.pid
.agent-env-watch.state

# pnpm local store
.pnpm-store/

# Test coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Documentation builds
docs/build/
site/

# Generated artifacts
dist/
*.db
*.sqlite
