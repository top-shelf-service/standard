{
  "name": "topshelf-standard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "mesh:boot": "tsx engine/mesh/boot.ts",
    "doctor": "pnpm mesh:boot && tsx scripts/doctor.ts",
    "build:index": "pnpm mesh:boot && tsx scripts/build-index.ts",
    "build:packs": "pnpm mesh:boot && tsx engine/compiler/build-pack.ts",
    "validate:all": "pnpm mesh:boot && tsx engine/validators/run-all.ts"
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "yaml": "^2.4.1"
  }
}
